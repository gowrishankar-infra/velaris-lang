// The same program as examples/secret.vel, printing the key.
//
// One line is different - the last one in main - and the program does
// not compile. The refusal names the value, what would emit it, and
// where the secret came from:
//
// error[E560] argument 1 of 'print' is Secret of Text, and 'print'
// performs io - a Secret cannot be printed, written, sent or
// passed to Python. It came from env(), line 27, through 'key',
// which returns Secret of Text (line 62)
//
// This is the point of the type. Nothing ran, nothing was logged, and
// no reviewer had to notice the line.
//
// velaris examples/secret_bad.vel --allow env,io

record Request {
    method: Text
    url: Text
    // the one secret field. A record that holds a Secret carries it,
    // so a whole Request cannot be printed either - not only this field
    authorization: Secret of Text
}

// env() hands back a Secret of Text (6.0). Nothing else here has to
// say "secret": the type travels with the value.
fn key() -> Secret of Text uses env {
    return env("API_KEY", "")
}

// Pure computation over a secret keeps the secret: joining text to one
// gives a Secret of Text, not a Text.
fn authorization(k: Secret of Text) -> Secret of Text {
    return "Bearer " + k
}

fn build(k: Secret of Text) -> Request {
    return Request(method: "GET",
    url: "https://api.example.com/v1/usage",
    authorization: authorization(k))
}

// A comparison over a secret gives an ordinary Bool - one bit, on
// purpose, because `if key == ""` has to be writable. SPEC.md 3.1 says
// what that costs and why the alternative stops nothing.
fn is_set(k: Secret of Text) -> Bool {
    return not (k == "")
}

// Every piece of this is a value that was never secret, which is why
// it compiles. Put the key in here and it does not.
fn summary(r: Request, present: Bool) -> Text {
    let said = "no"
    if present {
        said = "yes"
    }
    return r.method + " " + r.url
    + "\n  authorization: Bearer <the key - this program cannot print it>"
    + "\n  key present: " + said
}

fn main() uses io, env {
    let k = key()
    let request = build(k)
    print(summary(request, is_set(k)))
    if not is_set(k) {
        print("\nset API_KEY and run it again; the summary will not change.")
    }
    // the one line examples/secret.vel does not have
    print("using key: " + k)
}
