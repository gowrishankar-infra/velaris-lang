// Reads the last word of the input; there is no word, so position -1 is read.
fn last_word(words: List of Text) -> Text {
    return get(words, length(words) - 1)  // DANGER
}

fn main() uses io {
    let words: List of Text = []
    for part in split(read_line(), " ") {
        if length(part) > 0 {
            words = push(words, part)
        }
    }
    print("last word: " + last_word(words))
}
