// Compares each item with the next one; the last item has no next.
fn rises(xs: List of Int) -> Int {
    let count = 0
    let i = 0
    while i < length(xs) {
        if get(xs, i + 1) > get(xs, i) {  // DANGER
            count = count + 1
        }
        i = i + 1
    }
    return count
}

fn main() uses io {
    print(rises([2500, 45000, 12000]))
}
